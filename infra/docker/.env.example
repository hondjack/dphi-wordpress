# WordPress <-> MariaDB
WORDPRESS_DB_NAME=dphi_wordpress
WORDPRESS_DB_USER=dphi_wp
WORDPRESS_DB_PASSWORD=change_me_in_production
WORDPRESS_TABLE_PREFIX=dphi_

# MariaDB
MARIADB_ROOT_PASSWORD=change_me_in_production
MARIADB_DATABASE=dphi_wordpress
MARIADB_USER=dphi_wp
MARIADB_PASSWORD=change_me_in_production

# WordPress — doit correspondre au domaine réellement pointé (voir DNS, ticket WP-0 #7)
WP_HOME=https://dphi.africa
WP_SITEURL=https://dphi.africa

# Multisite — domaine racine (sans protocole), sécurité
WP_DOMAIN_CURRENT_SITE=dphi.africa
WP_DISALLOW_FILE_EDIT=true

# Bootstrap (scripts/bootstrap.sh) — obligatoire, le script échoue si vide
WP_ADMIN_PASSWORD=

# true en staging, false en prod
WORDPRESS_DEBUG=false
